# Copy to .env.local for local development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser: never put secrets in them.

# Supabase (local: values printed by `supabase start`). All server-only: the browser never
# talks to Supabase directly, so nothing here uses the NEXT_PUBLIC_ prefix.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Service role: bypasses RLS. Used only by lib/supabase/admin.ts (invite-only sign-up, ADR 0003).
SUPABASE_SERVICE_ROLE_KEY=

# App
# Public address of the app; used in email links. Must be listed in Supabase Auth redirect URLs.
APP_BASE_URL=http://127.0.0.1:3000
CRON_SECRET=
# HMAC key for analytics user_ref (architecture §8)
ANALYTICS_HMAC_SECRET=
EMAIL_FROM=

# AI (Milestone 3; provider is a founder decision D4)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL_SMALL=
AI_MODEL_STANDARD=
AI_MONTHLY_BUDGET_INR=5000

# Tests only: local Postgres used by supabase/tests (never a real project)
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres
