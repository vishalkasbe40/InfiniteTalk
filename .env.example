# Copy to .env.local for local development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser: never put secrets in them.

# Supabase (local: values printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used solely by named server-only modules (ADR 0003).
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_BASE_URL=http://localhost:3000
CRON_SECRET=
# HMAC key for analytics user_ref (architecture §8)
ANALYTICS_HMAC_SECRET=
EMAIL_FROM=

# AI (Milestone 3; provider is a founder decision D4)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL_SMALL=
AI_MODEL_STANDARD=
AI_MONTHLY_BUDGET_INR=5000

# Tests only: local Postgres used by supabase/tests (never a real project)
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres
